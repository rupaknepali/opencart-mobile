# Copy to mobile/.env for local development. Restart Expo (npx expo start -c) after changes.
# For store builds, set the same variables in eas.json "env" or as EAS environment variables.
# EXPO_PUBLIC_* values are compiled into the app and are NOT secret.

# Storefront URL with trailing slash (not the API URL). Must be reachable from the phone:
#   real phone on Wi-Fi  http://<your computer's LAN IP>:8090/   (macOS: ipconfig getifaddr en0)
#   iOS Simulator        http://localhost:8090/
#   Android emulator     http://10.0.2.2:8090/
#   release builds       https://your-store.com/   (https is required)
EXPO_PUBLIC_STORE_URL=http://localhost:8090/

# Extensions → Extensions → Modules → Mobile App API → API Key
EXPO_PUBLIC_API_KEY=

# Optional: an installed store language code
EXPO_PUBLIC_LANGUAGE=en-gb
