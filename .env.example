# Local development store (docker compose). Copy to .env and change every password.
# These credentials are for the local Docker store only — never reuse them on a real server.

DB_NAME=opencart
DB_USER=opencart
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# OpenCart admin account created by the CLI installer (see README.md)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Address the store's port 8090 listens on.
#   127.0.0.1  only this computer (default, safest)
#   0.0.0.0    your whole local network — needed to test on a real phone over Wi-Fi.
#              Anyone on the same network can then reach the store AND its admin.
STORE_BIND_ADDRESS=127.0.0.1

# Host port for the store (http://localhost:8090/)
STORE_PORT=8090
